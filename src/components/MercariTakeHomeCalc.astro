---
// src/components/MercariTakeHomeCalc.astro
---

<section class="calc-card">
<div class="calc-header">
    <div class="calc-icon-badge badge-green">
      <svg xmlns="http://www.w3.org/2000/svg" class="icon-svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <rect x="4" y="3" width="16" height="18" rx="2" stroke="currentColor"/>
        <line x1="8" y1="7" x2="16" y2="7" stroke="currentColor"/>
        <line x1="8" y1="11" x2="10" y2="11" stroke="currentColor"/>
        <line x1="14" y1="11" x2="16" y2="11" stroke="currentColor"/>
        <line x1="8" y1="15" x2="10" y2="15" stroke="currentColor"/>
        <line x1="14" y1="15" x2="16" y2="15" stroke="currentColor"/>
      </svg>
    </div>
    <div>
      <h2 class="calc-title">手元に残るお金（手取り額）計算機</h2>
      <p class="calc-subtitle">
        不用品を出品した際、販売手数料（10%）や送料・梱包費を差し引いて「口座に残る正味の振込金額」を算出します。<br />
        送料負けによる赤字を防ぎ、希望の手取り額を残すための出品価格設定や値下げ交渉時のチェックにご活用ください。
      </p>
    </div>
  </div>


  <div class="calc-two-columns">
    <!-- 左列：入力 -->
    <div class="calc-col-left">
      <div class="form-group">
        <label for="take-sale-price" class="form-label">販売価格 (円)</label>
        <div class="input-currency-wrapper">
          <span class="currency-prefix">¥</span>
          <input type="number" id="take-sale-price" value="3000" min="300" max="9999999" class="input-text" />
        </div>
        <div class="adjust-buttons">
          <button type="button" class="take-adjust-btn" data-amount="-1000">-1,000</button>
          <button type="button" class="take-adjust-btn" data-amount="-100">-100</button>
          <button type="button" class="take-adjust-btn" data-amount="100">+100</button>
          <button type="button" class="take-adjust-btn" data-amount="1000">+1,000</button>
        </div>
      </div>

      <div class="form-group">
        <label for="take-shipping" class="form-label flex-label">
          <svg xmlns="http://www.w3.org/2000/svg" class="mini-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
          </svg>
          配送方法・送料
        </label>
        <div class="select-wrapper">
          <select id="take-shipping" class="input-select">
            <option value="180">ゆうパケットポストmini (180円)</option>
            <option value="210" selected>ネコポス (210円)</option>
            <option value="220">ゆうパケットポスト (220円)</option>
            <option value="230">ゆうパケット (230円)</option>
            <option value="520">宅急便コンパクト (520円/専用箱含)</option>
            <option value="520">ゆうパケットプラス (520円/専用箱含)</option>
            <option value="750">宅急便・ゆうパック 60サイズ (750円)</option>
            <option value="850">宅急便 80サイズ (850円)</option>
            <option value="1050">宅急便 100サイズ (1,050円)</option>
            <option value="custom">その他（手動入力）</option>
          </select>
        </div>
      </div>

      <div id="take-custom-shipping-group" class="form-group is-hidden">
        <label for="take-custom-shipping" class="form-label-sub">送料手動設定 (円)</label>
        <input type="number" id="take-custom-shipping" value="210" min="0" class="input-text" />
      </div>

      <div class="form-group">
        <label for="take-pack-cost" class="form-label flex-label">
          <svg xmlns="http://www.w3.org/2000/svg" class="mini-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
          </svg>
          梱包資材費 (円)
        </label>
        <div class="input-currency-wrapper">
          <span class="currency-prefix">¥</span>
          <input type="number" id="take-pack-cost" value="0" min="0" class="input-text" />
        </div>
      </div>
    </div>

    <!-- 右列：答えカード -->
    <div class="calc-col-right result-card">
      <div>
        <div class="result-header text-green">
          <svg xmlns="http://www.w3.org/2000/svg" class="mini-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          手元に残る現金（振込金額）
        </div>

        <div class="result-main-price text-green" id="take-val-result">
          ¥ 2,490
        </div>

        <div class="result-badge-wrap">
          <span class="badge badge-green-sub">振込受取額</span>
        </div>

        <div class="result-details">
          <div class="detail-row">
            <span>販売手数料 (10%)</span>
            <span id="take-val-fee" class="detail-val">- ¥300</span>
          </div>
          <div class="detail-row">
            <span>送料・梱包費</span>
            <span id="take-val-shipping" class="detail-val">- ¥210</span>
          </div>
        </div>
      </div>

      <div class="result-info-box">
        💡 販売価格から「手数料10%」と「送料・梱包費」を引いた、口座に振り込まれる正味の金額です。
      </div>
    </div>
  </div>
</section>

<style>
  .calc-card {
    background-color: #ffffff;
    border-radius: 1.5rem;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
    border: 1px solid #f1f5f9;
    padding: 1.5rem;
  }
  @media (min-width: 640px) {
    .calc-card { padding: 2rem; }
  }

  .calc-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #f1f5f9;
  }
  .calc-icon-badge {
    padding: 0.625rem;
    border-radius: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .badge-green { background-color: #ecfdf5; color: #059669; }
  .icon-svg { width: 1.5rem; height: 1.5rem; }

  .calc-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #1e293b;
    margin: 0;
  }
  .calc-subtitle {
    font-size: 0.8125rem;
    color: #64748b;
    margin: 0.35rem 0 0;
    line-height: 1.5;
  }

  .calc-two-columns {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .calc-two-columns {
      flex-direction: row !important;
      align-items: stretch;
    }
    .calc-col-left {
      flex: 1 1 56% !important;
      min-width: 0;
    }
    .calc-col-right {
      flex: 1 1 44% !important;
      min-width: 300px;
    }
  }

  .form-group { margin-bottom: 1.25rem; }
  .form-label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: #334155;
    margin-bottom: 0.5rem;
  }
  .form-label-sub {
    display: block;
    font-size: 0.75rem;
    color: #64748b;
    margin-bottom: 0.25rem;
  }
  .flex-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .mini-icon { width: 1rem; height: 1rem; color: #64748b; }

  .input-currency-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }
  .currency-prefix {
    position: absolute;
    left: 1rem;
    color: #94a3b8;
    font-weight: 600;
    font-size: 0.95rem;
    pointer-events: none;
    z-index: 1;
  }
  .input-text {
    width: 100%;
    padding: 0.75rem 1rem 0.75rem 2.25rem !important;
    border-radius: 1rem;
    border: 1px solid #e2e8f0;
    background-color: #f8fafc;
    color: #0f172a;
    font-size: 1rem;
    font-weight: 700;
    outline: none;
    transition: all 0.2s;
  }
  .input-text:focus {
    background-color: #ffffff;
    border-color: #3b82f6;
    box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.12);
  }

  .select-wrapper { position: relative; width: 100%; }
  .input-select {
    width: 100%;
    padding: 0.75rem 1rem;
    border-radius: 1rem;
    border: 1px solid #e2e8f0;
    background-color: #f8fafc;
    color: #0f172a;
    font-size: 0.875rem;
    font-weight: 600;
    outline: none;
    cursor: pointer;
    transition: all 0.2s;
  }
  .input-select:focus {
    background-color: #ffffff;
    border-color: #3b82f6;
    box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.12);
  }

  .adjust-buttons {
    display: flex;
    gap: 0.375rem;
    margin-top: 0.625rem;
  }
  .adjust-buttons button {
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 0.5rem;
    background-color: #f1f5f9;
    color: #475569;
    border: none;
    cursor: pointer;
    transition: background-color 0.15s;
  }
  .adjust-buttons button:hover { background-color: #e2e8f0; }
  .is-hidden { display: none !important; }

  .result-card {
    background-color: #f0f7ff !important;
    border-radius: 1.5rem;
    padding: 1.5rem;
    border: 1px solid #dbeafe;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .result-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }
  .text-green { color: #059669; }

  .result-main-price {
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    margin-bottom: 0.5rem;
  }
  @media (min-width: 640px) {
    .result-main-price { font-size: 2.75rem; }
  }

  .result-badge-wrap { margin-bottom: 1.25rem; }
  .badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
  }
  .badge-green-sub { background-color: #d1fae5; color: #065f46; }

  .result-details {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: #475569;
  }
  .detail-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .detail-val { font-weight: 600; color: #1e293b; }

  .result-info-box {
    background-color: rgba(255, 255, 255, 0.8);
    border-radius: 1rem;
    padding: 0.875rem 1rem;
    font-size: 0.75rem;
    color: #64748b;
    line-height: 1.5;
    border: 1px solid #e0f2fe;
  }

  :global(.dark) .calc-card {
    background-color: #0f172a;
    border-color: #1e293b;
  }
  :global(.dark) .calc-title { color: #f8fafc; }
  :global(.dark) .form-label { color: #cbd5e1; }
  :global(.dark) .input-text, :global(.dark) .input-select {
    background-color: #1e293b;
    border-color: #334155;
    color: #ffffff;
  }
  :global(.dark) .result-card {
    background-color: rgba(30, 41, 59, 0.7) !important;
    border-color: #334155;
  }
  :global(.dark) .result-info-box {
    background-color: #0f172a;
    border-color: #1e293b;
  }
  :global(.dark) .detail-val { color: #f1f5f9; }
</style>

<script>
  const takeSalePrice = document.getElementById('take-sale-price') as HTMLInputElement;
  const takeShipping = document.getElementById('take-shipping') as HTMLSelectElement;
  const takeCustomShippingGroup = document.getElementById('take-custom-shipping-group')!;
  const takeCustomShipping = document.getElementById('take-custom-shipping') as HTMLInputElement;
  const takePackCost = document.getElementById('take-pack-cost') as HTMLInputElement;

  const takeValResult = document.getElementById('take-val-result')!;
  const takeValFee = document.getElementById('take-val-fee')!;
  const takeValShipping = document.getElementById('take-val-shipping')!;

  function calcTake() {
    const sale = Number(takeSalePrice.value) || 0;
    let ship = Number(takeShipping.value) || 0;
    if (takeShipping.value === 'custom') {
      takeCustomShippingGroup.classList.remove('is-hidden');
      ship = Number(takeCustomShipping.value) || 0;
    } else {
      takeCustomShippingGroup.classList.add('is-hidden');
    }
    const pack = Number(takePackCost.value) || 0;

    const fee = Math.floor(sale * 0.1);
    const totalCost = ship + pack;
    const payout = sale - fee - totalCost;

    takeValFee.textContent = `- ¥${fee.toLocaleString()}`;
    takeValShipping.textContent = `- ¥${totalCost.toLocaleString()}`;
    takeValResult.textContent = `¥ ${payout.toLocaleString()}`;

    if (payout < 0) {
      takeValResult.style.color = '#e11d48';
    } else {
      takeValResult.style.color = '#059669';
    }
  }

  [takeSalePrice, takeShipping, takeCustomShipping, takePackCost].forEach(el => {
    el.addEventListener('input', calcTake);
    el.addEventListener('change', calcTake);
  });

  document.querySelectorAll('.take-adjust-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const val = Number((e.currentTarget as HTMLElement).dataset.amount);
      takeSalePrice.value = String(Math.max(300, (Number(takeSalePrice.value) || 0) + val));
      calcTake();
    });
  });

  calcTake();
</script>