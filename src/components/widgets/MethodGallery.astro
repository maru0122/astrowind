---
import { methods } from '~/data/methods';
---

<section id="method" class="px-4 py-12 mx-auto max-w-7xl sm:px-6 lg:px-8 lg:py-16">
  <div class="mb-8 md:mx-auto md:mb-10 max-w-3xl text-center">
    <h2 class="text-2xl font-bold leading-none tracking-tight sm:text-3xl mb-3 font-heading">
      開発メソッド・設計ノウハウ
    </h2>
    <p class="text-sm text-muted dark:text-slate-400">
      AIを相棒にして破綻しない仕組みを構築するための設計手法とプロンプトです。
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    {
      methods.map((item) => (
        <div class="flex flex-col justify-between bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow">
          <div>
            <!-- タグ表示部（複数タグ対応） -->
            <div class="flex flex-wrap gap-1.5 mb-3">
              {item.tags.map((tag) => (
                <span class="inline-block px-2.5 py-0.5 text-xs font-semibold text-blue-800 bg-blue-100 rounded dark:bg-blue-900/50 dark:text-blue-300">
                  #{tag}
                </span>
              ))}
            </div>

            <!-- タイトル -->
            <h3 class="text-xl font-bold mb-2 text-slate-900 dark:text-white">
              {item.title}
            </h3>

            <!-- 説明文 -->
            <p class="text-sm text-slate-600 dark:text-slate-400 mb-4 leading-relaxed">
              {item.description}
            </p>
          </div>

          <!-- アクションリンク -->
          <div class="pt-4 border-t border-slate-100 dark:border-slate-800">
            <a
              href={item.url}
              class="inline-flex items-center text-sm font-bold text-blue-600 dark:text-blue-400 hover:underline"
            >
              ノウハウを読む ➔
            </a>
          </div>
        </div>
      ))
    }
  </div>
</section>