---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';

// 💡 GIF画像をインポート
import chatsaver01 from '~/assets/images/chatsaver01.gif';

// ⚠️ 実際のGumroad商品URLに書き換えてください
const GUMROAD_URL = 'https://maru0122.gumroad.com/l/chatsaverforgemini';

const metadata = {
  title: 'Chat Saver for Gemini ソースコード — e-Shikumi-Labo',
  description: '商用利用・改変可能なChrome拡張機能ボイラープレート。GeminiのチャットログをリアルタイムでGoogleスプレッドシートとDrive(Markdown)に自動同期。',
};
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <Hero
    tagline="商用利用可能・改変自由な Chrome拡張機能 × GAS ボイラープレート"
    title="Geminiの会話ログをスプレッドシート＆Driveに自動同期"
    actions={[
      {
        text: 'Gumroadでソースコードを入手（$29.99）',
        href: GUMROAD_URL,
        variant: 'primary',
        target: '_blank',
        rel: 'noopener noreferrer',
        icon: 'tabler:external-link',
      },
    ]}
  >
    <Fragment slot="subtitle">
      <span class="font-bold text-primary">【買い切り $29.99 / 月額費用ゼロ】</span><br />
      Geminiとのチャットログを、GoogleスプレッドシートやGoogleドライブ（Markdown形式）へリアルタイムに自動同期する拡張機能の完全なソースコード。<br />
      <strong>商用利用・自社プロダクトへの組み込みが可能。</strong>DOM変更に強い独立モジュール（parser.js）を採用し、開発時間を大幅にショートカットできます。
    </Fragment>

    <!-- 💡 GIF動画の表示エリア -->
    <Fragment slot="image">
      <div class="relative max-w-4xl mx-auto rounded-xl shadow-2xl overflow-hidden border border-gray-200 dark:border-slate-700">
        <img
          src={chatsaver01.src}
          alt="Chat Saver for Gemini Chrome Extension 動作デモ"
          class="w-full h-auto"
          loading="eager"
        />
      </div>
    </Fragment>
  </Hero>

  <div class="max-w-4xl mx-auto px-4 py-8">
    <!-- 含まれるコンテンツ（What's Included） -->
    <div class="py-8 border-t border-gray-100 dark:border-slate-800">
      <Features2
        title="📦 含まれるコンテンツ"
        subtitle="独自のGemini同期ワークフローを構築・カスタマイズ・保守するために必要なものがすべて揃っています。"
        columns={2}
        items={[
          {
            title: 'Chrome拡張機能 ソースコード',
            description: 'Manifest V3 / Vanilla JS準拠。DOM解析をカプセル化した分離設計（parser.js）を採用し、保守性を高めています。',
            icon: 'tabler:brand-chrome',
          },
          {
            title: 'バックエンド用 GASコード（Code.gs）',
            description: 'Google Workspaceの無料枠内で完全動作するサーバーレスなバックエンドロジック（スプレッドシート＆Drive連携）です。',
            icon: 'tabler:file-code',
          },
          {
            title: 'セットアップ手順書（SETUP.md）',
            description: '拡張機能の読み込みからGASのデプロイまで、ノーコードで数分で完了するステップバイステップ解説。',
            icon: 'tabler:book',
          },
          {
            title: 'AI活用 メンテナンスガイド',
            description: 'GeminiのUI変更が生じた際も、プロンプトを使ってご自身で要素選択（セレクタ）を素早く更新・修復できます。',
            icon: 'tabler:message-code',
          },
        ]}
      />
    </div>

    <!-- ライセンス・利用規約 -->
    <div class="py-8 border-t border-gray-100 dark:border-slate-800">
      <h2 class="text-2xl font-bold mb-6 text-gray-900 dark:text-white">📜 ライセンス（できること・できないこと）</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-6 bg-green-50 dark:bg-green-900/20 rounded-xl border border-green-200 dark:border-green-800">
          <h3 class="text-lg font-bold text-green-800 dark:text-green-300 mb-3 flex items-center gap-2">✅ 許可されること</h3>
          <ul class="list-disc list-inside text-muted space-y-2 text-sm md:text-base">
            <li>個人利用、社内ツール、<strong>商用目的での利用</strong></li>
            <li>ソースコードの<strong>自由な改変・カスタマイズ</strong></li>
            <li>改変した成果物のストア配信（<strong>有料販売含む</strong>）</li>
            <li>クライアントワーク（受託開発）への組み込み</li>
          </ul>
        </div>
        <div class="p-6 bg-red-50 dark:bg-red-900/20 rounded-xl border border-red-200 dark:border-red-800">
          <h3 class="text-lg font-bold text-red-800 dark:text-red-300 mb-3 flex items-center gap-2">❌ 禁止されること</h3>
          <ul class="list-disc list-inside text-muted space-y-2 text-sm md:text-base">
            <li>ソースコード自体の<strong>転売・再配布・第三者への共有</strong></li>
            <li>GitHub等のパブリック（公開）リポジトリでのホスティング</li>
            <li>本コードをベースにした「開発者向けテンプレート」としての競合販売</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- 動作環境・制約事項 -->
    <div class="py-8 border-t border-gray-100 dark:border-slate-800">
      <h2 class="text-2xl font-bold mb-6 text-gray-900 dark:text-white">⚡ 動作環境・制約事項</h2>
      <div class="space-y-6">
        <div>
          <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">💻 動作環境</h3>
          <ul class="list-disc list-inside text-muted space-y-2">
            <li>PC版 <strong>Google Chrome ブラウザ</strong>（最新版）</li>
            <li><strong>Google アカウント</strong>（GAS、スプレッドシート、Googleドライブ利用のため）</li>
          </ul>
        </div>
        <div>
          <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">⚠️ 技術的な制約事項（不具合ではありません）</h3>
          <ul class="list-disc list-inside text-muted space-y-2">
            <li><strong>スマホアプリからの会話は対象外です：</strong> PC版Chrome拡張機能の仕組みを利用しているため、スマートフォンからは動作しません。</li>
            <li><strong>過去ログの一括同期機能はありません：</strong> ただし、過去のスレッドであっても、PCブラウザで一度開きさえすれば自動検知して順次保存されます。</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- 免責事項・自走に関する説明（Disclaimer Box） -->
    <div class="my-12 p-6 md:p-8 bg-amber-50 dark:bg-slate-800/50 border-l-4 border-amber-500 rounded-r-lg">
      <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3 flex items-center gap-2">
        <span>⚠️</span> ご利用にあたっての重要な注意事項（免責事項）
      </h3>
      <p class="text-base text-muted leading-relaxed mb-4">
        本商品は、完全自動でブラックボックスなツールではなく、ご自身で仕組みを理解しコントロールしていただくための<strong>「自走型ソースコードパッケージ（教材）」</strong>として提供しています。相手がGoogle（Gemini）である以上、画面仕様変更によって一時的に動作しなくなる可能性があります。
      </p>
      <p class="text-base text-muted leading-relaxed">
        そのため、将来的な仕様変更が生じた場合でも長期的に使い続けられるよう、<strong>コピペで使える「AIプロンプト付きメンテナンスガイド」</strong>を同梱しています。AIを活用してご自身でコードをアップデート・保守できるスキルが身につく仕様となっています。
      </p>
    </div>

    <!-- 💰 価格＆購入セクション -->
    <div class="my-12 p-8 bg-slate-50 dark:bg-slate-800/80 rounded-2xl border-2 border-primary/20 text-center shadow-md">
      <span class="inline-block px-3 py-1 text-xs font-bold tracking-wider text-primary uppercase bg-primary/10 rounded-full mb-3">
        One-Time Purchase / 買い切り価格
      </span>
      <div class="text-4xl md:text-5xl font-extrabold text-gray-900 dark:text-white my-2">
        $29.99 <span class="text-base font-normal text-muted">（月額費用ゼロ）</span>
      </div>
      <p class="text-sm text-muted mb-6">
        追加のサブスク費用やサーバー維持費は一切不要。購入後すぐにすべてのソースコードをダウンロードできます。
      </p>
      
      <a
        href={GUMROAD_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center px-8 py-4 text-lg font-bold text-white bg-primary rounded-lg shadow-lg hover:bg-primary/90 transition duration-200 w-full sm:w-auto"
      >
        Gumroadでソースコードを入手する 🚀
      </a>
      <p class="text-xs text-muted mt-3">
        ※ 安全な決済プラットフォーム「Gumroad」へ遷移します（クレジットカード/Apple Pay等対応）
      </p>
    </div>
  </div>
</Layout>