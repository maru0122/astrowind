---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: '会社概要 — e-Shikumi-Labo',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Company Overview"
    title="当ラボについて"
    subtitle="お金も場所もかけずに楽しめる「大人のデジタルDIY」。AIを相棒に、自分で作り、自分で直せる力を育てる。"
  />

  <div class="max-w-3xl mx-auto px-4 pb-16">
    <!-- 基本情報テーブル -->
    <div class="overflow-x-auto border-t border-b border-gray-200 py-8 mb-12">
      <table class="w-full text-left border-collapse">
        <tbody>
          <tr>
            <th class="py-4 font-bold text-lg w-1/3">名称</th>
            <td class="py-4 text-lg">e-Shikumi-Labo（イー・シクミ・ラボ）</td>
          </tr>
          <tr>
            <th class="py-4 font-bold text-lg">代表者</th>
            <td class="py-4 text-lg">
              シン（e-Shikumi-Labo 所長）<br />
              <a href="/profile" class="text-primary hover:underline text-sm font-semibold">→ 詳細なプロフィールはこちら</a>
            </td>
          </tr>
          <tr>
            <th class="py-4 font-bold text-lg">設立</th>
            <td class="py-4 text-lg">2015年4月</td>
          </tr>
          <tr>
            <th class="py-4 font-bold text-lg">活動形態</th>
            <td class="py-4 text-lg">個人研究開発・情報メディア運営</td>
          </tr>
          <tr>
            <th class="py-4 font-bold text-lg">連絡先</th>
            <td class="py-4 text-lg">
              <a href="/contact" class="text-primary hover:underline font-semibold">→ お問い合わせフォームはこちら</a>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- ラボの目的・活動方針（簡潔にまとめ） -->
    <div class="py-8">
      <h2 class="text-2xl font-bold mb-4 text-gray-900 border-b-2 border-gray-100 pb-2">
        e-Shikumi-Labo の理念
      </h2>
      <p class="text-lg text-gray-700 leading-relaxed mb-4">
        e-Shikumi-Laboは、Chrome拡張機能とAIを活用し、自分のデスク周りを面白くする<strong>「大人のデジタルDIY」の作例公開および情報発信を行っている個人ラボ</strong>です。
      </p>
      <p class="text-lg text-gray-700 leading-relaxed">
        ブラックボックス化した「完成品のツールを渡して終わり」にするのではなく、環境が変わってもAIと一緒に<strong>自分の手で修正・管理できる「自走力」</strong>を育てるためのノウハウや実験ログを共有しています。
      </p>
    </div>

    <!-- 主な取り組み内容 -->
    <div class="py-8">
      <Features2
        title="主な取り組み内容"
        items={[
          {
            title: '「Chrome拡張機能 × AI」の実験・作例公開',
            description: 'ブラウザ上で安定してリアルタイムデータを取得するChrome拡張機能と、Googleスプレッドシート等を連携させたツール作例を発信しています。',
            icon: 'tabler:brand-chrome',
          },
          {
            title: '大人のデジタルDIY（情報発信）',
            description: 'お金も場所もかけず、自分専用の便利な道具を作る「純粋に楽しい趣味としてのツール制作」のノウハウを公開しています。',
            icon: 'tabler:tool',
          },
          {
            title: '「自分で直せる力」を養う個別サポート',
            description: '作例のカスタマイズや自作ツールで詰まった部分について、画面を見ながらオンラインで相談できる個別窓口を用意しています。',
            icon: 'tabler:users',
          },
        ]}
      />
    </div>

  </div>
</Layout>