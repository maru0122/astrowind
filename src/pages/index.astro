---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import ProductGallery from '~/components/widgets/ProductGallery.astro';
import MethodGallery from '~/components/widgets/MethodGallery.astro';

const metadata = {
  title: 'e-Shikumi-Labo｜大人のデジタルDIY',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      { variant: 'primary', text: '作例ギャラリーを見る', href: '#gallery' },
      { text: 'プロフィール', href: '#profile' },
    ]}
  >
    <Fragment slot="title">
      <span class="text-lg sm:text-xl font-bold text-slate-600 dark:text-slate-400 block mb-1 tracking-normal">
        Chrome拡張機能 × AI × スプレッドシート
      </span>
      
      <span class="text-2xl sm:text-3xl lg:text-4xl leading-snug block font-bold">
        <span class="inline-block">自分専用の「道具」を、</span>
        <span class="inline-block">自分の手で構築・維持する</span>
      </span>
    </Fragment>

    <Fragment slot="subtitle">
      AIを相棒にして、日々の作業環境を快適にする仕組みを自作する。<br class="hidden sm:inline" />
      仕様変更やトラブルが起きても、自力で修正して使い続ける「自走力」を養うラボです。
    </Fragment>
  </Hero>

  <!-- カタログセクション（コンポーネント呼び出し） -->
  <ProductGallery />

  <!-- 2. 開発メソッド・ノウハウ (🟢 ここに追加) -->
  <MethodGallery />

  <!-- プロフィール -->
  <Content
    isReversed
    id="profile"
    title="プロフィール"
    callToAction={{ text: 'プロフィール詳細', href: '/profile', variant: 'primary' }}
    image={{
      src: '~/assets/images/profile.png',
      alt: 'シン（e-Shikumi-Labo 所長）',
    }}
  >
<Fragment slot="content">
  <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
    【Chrome拡張機能 × AIで養う自走力】
  </h3>
  <p class="mb-4 text-sm font-semibold text-slate-500 dark:text-slate-400">
    50代｜関東在住｜現場サポート（業務改善・VBA/RPA担当）
  </p>
  <p class="mb-4">
    外部の現場スタッフとして業務改善を担当しています。30年の経験から現場の最適解が見えても立場上踏み込めない、「知識も経験もあるのに力を出し切れない」50代ならではの不完全燃焼感を抱えてきました。
  </p>
  <p class="mb-4">
    また、過去に越境EC向けツールを自作・提供した際、サイトの仕様変更やボット対策に振り回された経験から、「完成品ツールを渡して終わり」にする仕組みの限界も痛感。そこから行き着いたのが、ボット対策に強い<b>「Chrome拡張機能」</b>と、開発を任せられる<b>「AI」</b>の掛け合わせでした。
  </p>
  <p class="mb-4">
    当ラボでは「ツールを買って終わり」ではなく、環境が変わってもAIと一緒に<b>自分で直せる力（自走力）</b>を身につける「大人のデジタルDIY」の作例公開と、個別での実践サポートを行っています。
  </p>
</Fragment>
  </Content>
</Layout>