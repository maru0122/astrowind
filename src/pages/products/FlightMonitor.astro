---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import heroImg from '~/assets/images/products/flightmonitor/flightmonitor01.png';

const metadata = {
  title: 'Flight Monitor - 作例詳細・アーキテクチャ | Chrome拡張機能',
  description: '指定した監視拠点（自宅等）の上空を通過する航空機データをリアルタイムに取得し、コックピット風ダークテーマ地図とフライトカード型一覧に表示する完全ローカル・サーバーレスなChrome拡張機能です。',
};
---

<PageLayout metadata={metadata}>
  <!-- ヒーローセクション -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'GitHubでコードを見る',
        href: 'https://github.com/maru0122/FlightMonitor',
        target: '_blank',
        icon: 'tabler:brand-github',
      },
    ]}
    image={{
      src: heroImg,
      alt: 'Flight Monitor 動作イメージ',
    }}
  >
    <Fragment slot="title">
      Flight Monitor
    </Fragment>
    <Fragment slot="subtitle">
      指定した監視拠点（自宅等）の上空を通過する航空機データをリアルタイムに取得し、Side Panel上のダークテーマ地図とフライトカード型一覧に表示するChrome拡張機能です。サーバーレス設計により、OpenSky APIおよび公開Googleスプレッドシートからブラウザ上で直接データを同期・結合します。
    </Fragment>
  </Hero>

  <!-- 特徴 -->
  <Features
    id="features"
    tagline="Features"
    title="特徴"
    items={[
      {
        title: 'リアルタイムなデータ取得',
        description: 'OpenSky Network APIを利用し、10〜15秒ごとの定期通信で航空機の位置・高度・速度を正確に取得します。',
        icon: 'tabler:radar',
      },
      {
        title: 'コックピット風ダークテーマ',
        description: 'Leaflet.jsとEsriダークタイルを採用。ステータス発光バッジを備えたレーダー風UIで視認性を高めています。',
        icon: 'tabler:moon',
      },
      {
        title: '独自データの自動結合',
        description: '公開Googleスプレッドシートと連携し、便名から路線、発着時刻、IATAコードを動的にタイムテーブルへ付加します。',
        icon: 'tabler:table',
      },
      {
        title: '安全なサーバーレス設計',
        description: '独自の外部サーバーを経由せず、APIやシートからブラウザへ直接データを取得。設定はローカルにのみ安全に保存されます。',
        icon: 'tabler:shield-lock',
      },
    ]}
  />

  <!-- 構成要素と処理の流れ (Stepsを使用) -->
  <Steps
    id="architecture-flow"
    tagline="Architecture & Flow"
    title="構成要素と処理の流れ"
    items={[
      {
        title: '1. 設定のロードとマップ初期化',
        description: 'サイドパネルの起動時にローカルストレージからユーザー設定を取得し、ダークテーママップ上にHomeマーカーや監視エリアを描画して表示基盤を初期化します。',
        icon: 'tabler:map-pin',
      },
      {
        title: '2. 外部データソースとの同期 (api.js)',
        description: '10〜15秒間隔のポーリング処理により、OpenSky APIから航空機生データを取得します。同時にGoogleスプレッドシートから便名に紐づく付加情報（路線・時刻等）を読み込みます。',
        icon: 'tabler:cloud-download',
      },
      {
        title: '3. データの統合・変換処理 (utils.js)',
        description: '現在位置からの距離計算（ハバーサイン公式）やコールサインの抽出を実行し、複数のデータソースから得た情報を拡張機能内で扱いやすい形式に統合・変換します。',
        icon: 'tabler:calculator',
      },
      {
        title: '4. UIの動的更新と多言語化',
        description: '最新のデータをもとに地図上のマーカー位置を更新します。同時に航空会社ロゴを動的取得してフライトカードを再構築し、画面に反映させます。',
        icon: 'tabler:layout-dashboard',
      },
    ]}
  />

  <!-- 必要なもの -->
  <Features
    id="requirements"
    tagline="Requirements"
    title="必要なもの"
    subtitle="複雑なバックエンドサーバーの構築は不要です。上記のアカウントとデータソースを用意し、拡張機能のOptionsページから設定するだけで動作を開始します。"
    columns={2}
    items={[
      {
        title: 'OpenSkyアカウント（無料登録可）',
        description: 'OpenSky Network APIを利用し、10〜15秒ごとの定期通信で航空機の位置・高度・速度を正確に取得するために必要です。',
        icon: 'tabler:user',
      },
      {
        title: '公開設定のGoogleスプレッドシート',
        description: '便名、出発地、到着地、出発時刻、到着時刻、IATAコードを含むCSVファイル。（当ラボで毎月1回程度自動更新・提供予定）',
        icon: 'tabler:table-export',
      },
    ]}
  />

  <!-- CallToAction 
  <CallToAction
    title="📄 関連記事・技術ドキュメント"
    actions={[
      {
        variant: 'primary',
        text: 'GitHubでコードを見る',
        href: 'https://github.com/YOUR_GITHUB_REPO',
        target: '_blank',
        icon: 'tabler:brand-github',
      },
      {
        variant: 'secondary',
        text: 'OpenSky API ドキュメント',
        href: 'https://openskynetwork.github.io/opensky-api/rest.html',
        target: '_blank',
        icon: 'tabler:external-link',
      },
    ]}
  /> -->
</PageLayout>