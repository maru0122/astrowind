---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

// ★ 先ほど作った英語版レイアウトを使用
import Layout from '~/layouts/PageLayoutEn.astro';
import BlogList from '~/components/blog/List.astro';
import Headline from '~/components/blog/Headline.astro';
import Pagination from '~/components/blog/Pagination.astro';

import { blogListRobots, getStaticPathsBlogList } from '~/utils/blog';

export const prerender = true;

// 🟢 【蛇口】英語版（lang: 'en'）の記事だけを徹底抽出
export const getStaticPaths = (async ({ paginate }) => {
  const customPaginate = (posts: any[], options: any) => {
    const enPosts = posts
      .filter((post) => (post as any).lang === 'en' || (post as any).frontmatter?.lang === 'en')
      .map((post) => ({
        ...post,
        // 🟢 リンク先を強制的に /en/ 配下に上書き
        permalink: `/en/${post.slug}`,
      }));
    return paginate(enPosts, options);
  };

  return await getStaticPathsBlogList({ paginate: customPaginate as any });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;

const metadata = {
  title: `Blog${currentPage > 1 ? ` — Page ${currentPage}` : ''}`,
  robots: {
    index: blogListRobots?.index && currentPage === 1,
    follow: blogListRobots?.follow,
  },
  openGraph: {
    type: 'blog',
  },
};
---

<Layout metadata={metadata}>
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <Headline
      subtitle="Discover insights, tips, and articles about automation and workflow optimization."
    >
      Blog
    </Headline>
    <BlogList posts={page.data} />
    <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
  </section>
</Layout>