---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';

// 💡 GIF Image Import
import chatsaver01 from '~/assets/images/chatsaver01.gif';

// ⚠️ Replace with your actual Gumroad product URL
const GUMROAD_URL = 'https://maru0122.gumroad.com/l/YOUR_PRODUCT_ID';

const metadata = {
  title: 'Gemini Chat Sync Boilerplate — e-Shikumi-Labo',
  description: 'A complete Chrome Extension boilerplate that syncs Google Gemini chat logs to Google Sheets and Drive in real-time.',
};
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <Hero
    tagline="Chrome Extension & GAS Boilerplate"
    title="Sync Gemini Chat Logs to Sheets & Drive"
    actions={[
      {
        text: 'Get Source Code ($29.99)',
        href: GUMROAD_URL,
        variant: 'primary',
        target: '_blank',
        rel: 'noopener noreferrer',
        icon: 'tabler:external-link',
      },
    ]}
  >
    <Fragment slot="subtitle">
      <span class="font-bold text-primary">【$29.99 One-Time Purchase / Zero Monthly Fees】</span><br />
      A complete, production-ready Chrome Extension boilerplate that syncs Google Gemini chat logs to Google Sheets and Google Drive in real-time.<br />
      Built on <strong>Manifest V3</strong> and <strong>Google Apps Script (GAS)</strong> with <strong>$0 backend costs</strong>.
    </Fragment>

    <!-- 💡 GIF Demo Section -->
    <Fragment slot="image">
      <div class="relative max-w-4xl mx-auto rounded-xl shadow-2xl overflow-hidden border border-gray-200 dark:border-slate-700">
        <img
          src={chatsaver01.src}
          alt="Gemini Chat Sync Chrome Extension Demo"
          class="w-full h-auto"
          loading="eager"
        />
      </div>
    </Fragment>
  </Hero>

  <div class="max-w-4xl mx-auto px-4 py-8">
    <!-- What's Included -->
    <div class="py-8 border-t border-gray-100 dark:border-slate-800">
      <Features2
        title="📦 What's Included"
        subtitle="Everything you need to deploy, customize, and maintain your own Gemini sync workflow."
        columns={2}
        items={[
          {
            title: 'Chrome Extension Source Code',
            description: 'Full Manifest V3 / Vanilla JS codebase with isolated parser architecture for easy updates.',
            icon: 'tabler:brand-chrome',
          },
          {
            title: 'Backend GAS Script (Code.gs)',
            description: 'Serverless backend logic running entirely within Google Workspace free tier.',
            icon: 'tabler:file-code',
          },
          {
            title: 'Setup Documentation (SETUP.md)',
            description: 'Step-by-step setup guide to get your extension and GAS backend running in minutes.',
            icon: 'tabler:book',
          },
          {
            title: 'AI Maintenance Guide',
            description: 'Includes ready-to-use AI prompts to help you adapt selectors if Gemini’s UI changes.',
            icon: 'tabler:message-code',
          },
        ]}
      />
    </div>

    <!-- Requirements & Tech Stack -->
    <div class="py-8 border-t border-gray-100 dark:border-slate-800">
      <h2 class="text-2xl font-bold mb-6 text-gray-900 dark:text-white">⚡ System Requirements</h2>
      <ul class="list-disc list-inside text-lg text-muted space-y-2">
        <li>Desktop <strong>Google Chrome Browser</strong></li>
        <li><strong>Google Account</strong> (for Google Apps Script, Sheets, and Drive integration)</li>
      </ul>
    </div>

    <!-- Philosophy & Disclaimer Box -->
    <div class="my-12 p-6 md:p-8 bg-amber-50 dark:bg-slate-800/50 border-l-4 border-amber-500 rounded-r-lg">
      <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3 flex items-center gap-2">
        <span>⚠️</span> Important Disclaimer & Usage Terms
      </h3>
      <p class="text-base text-muted leading-relaxed mb-4">
        This product is provided as a <strong>self-reliant codebase</strong> designed for complete user control, rather than a permanently guaranteed black-box service. Web interfaces (such as Gemini) naturally evolve over time.
      </p>
      <p class="text-base text-muted leading-relaxed">
        To ensure long-term usability, we include a comprehensive <strong>Maintenance Guide equipped with ready-to-use AI prompts</strong>. This empowers you to easily update selectors and maintain the code independently whenever UI changes occur.
      </p>
    </div>

    <!-- 💰 Pricing & CTA Section -->
    <div class="my-12 p-8 bg-slate-50 dark:bg-slate-800/80 rounded-2xl border-2 border-primary/20 text-center shadow-md">
      <span class="inline-block px-3 py-1 text-xs font-bold tracking-wider text-primary uppercase bg-primary/10 rounded-full mb-3">
        One-time purchase
      </span>
      <div class="text-4xl md:text-5xl font-extrabold text-gray-900 dark:text-white my-2">
        $29.99 <span class="text-base font-normal text-muted">(No subscription fees)</span>
      </div>
      <p class="text-sm text-muted mb-6">
        No recurring subscriptions or server costs. Instant access to full source code after purchase.
      </p>
      
      <a
        href={GUMROAD_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center px-8 py-4 text-lg font-bold text-white bg-primary rounded-lg shadow-lg hover:bg-primary/90 transition duration-200 w-full sm:w-auto"
      >
        Get Source Code on Gumroad 🚀
      </a>
      <p class="text-xs text-muted mt-3">
        * You will be redirected to Gumroad for secure checkout and instant file download.
      </p>
    </div>
  </div>
</Layout>